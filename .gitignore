# 가상환경
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 런타임 데이터. 원본 PDF는 절대 커밋하지 않음 (노션 01 §18.6 저작권)
# data/ 통째로 무시하면 git이 안으로 내려가지 않아 아래 예외가 먹지 않는다.
data/*

# 평가 결과는 남긴다. "그때 이런 수치가 나왔다"를 증명하는 자료이고,
# 설정을 바꾼 전후를 나중에 대조하려면 원본이 있어야 한다.
# 프로브 결과(data/probes)는 여전히 올리지 않는다. 그쪽은 정답이 없는 비교용이다.
!data/evals/

# 어떤 매뉴얼 6권을 썼는지 적어 둔 목록. 파일명, 공개 다운로드 주소, sha256,
# 쪽수만 있고 본문은 없다. 이게 없으면 새 컴퓨터에서 같은 판본을 받을 수 없고,
# 판본이 다르면 평가 정답의 페이지 번호가 전부 어긋난다.
!data/manifest.json

# 환경별 설정
.env

# 벤치마크 원본 로그
scripts/output/

# IDE
.vscode/
.idea/
