# 실제 값을 채운 .env 파일은 커밋하지 않음. .gitignore에 등록되어 있음.
# 값은 비밀번호 관리자에서 관리하고, 이 파일은 키 이름만 공유하는 용도임.

# Ollama (로컬 추론)
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Qdrant (Vector Store)
# 기본 설정은 무인증이므로 반드시 루프백에 바인딩하고 API 키를 설정할 것
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=

# 평가 기준선 측정 전용 (노션 07 Step 7)
# 로컬 점수가 설계 문제인지 모델 한계인지 구분하기 위해 1회만 사용함.
# 운영 경로에서는 외부 API를 호출하지 않음.
EVALUATION_BASELINE_API_KEY=
